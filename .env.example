# Secrets obligatoires pour l'espace Agence (/dashboard et /api/* protégées)
# Générez une chaîne aléatoire longue (>= 32 caractères) :
TRACKCARGO_SESSION_SECRET=remplacez_par_une_cle_aleatoire_de_32_caracteres_minimum

# Mot de passe administrateur (préférez TRACKCARGO_ADMIN_PASSWORD_HASH généré par npm run setup:env en production)
TRACKCARGO_ADMIN_PASSWORD=remplacez_par_un_mot_de_passe_robuste
# TRACKCARGO_ADMIN_PASSWORD_HASH=scrypt:salt:hash

# --- Agents Cloud 24/7 (GitHub Actions Secrets) ---
# API IA pour corrections autonomes (Gemini API gratuite/payante ou OpenAI)
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Notifications Telegram (obligatoire pour recevoir les rapports sur votre téléphone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
